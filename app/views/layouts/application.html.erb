<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Shared Bills" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "bootstrap/css/bootstrap.min", "application", "data-turbo-track": "reload" %>
    <%# Bootstrap 3's plugins need a global jQuery, so they load as classic scripts. %>
    <%= javascript_include_tag "jquery/jquery.min", "bootstrap/js/bootstrap.min", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield(:head) %>
  </head>
  <body>
  <%= render "layouts/menu" %>
    <div class="container">
      <% flash.each do |name, msg| %>
        <% if name == 'notice' || name == :notice %>
          <%= tag :div, id: "flash-notice", class: "alert alert-success" %>
        <% elsif name == 'alert' || name == :alert %>
          <%= tag :div, id: "flash-alert", class: "alert alert-warning" %>
        <% else %>
          <%= tag :div, id: "flash-#{name}", class: "alert alert-#{name}" %>
        <% end %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
          <%= msg %>
        </div>
      <% end %>
      <%= content_tag :h1, yield(:title) if show_title? %>
      <%= yield %>
    </div>
  </body>
</html>
