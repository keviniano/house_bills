# Secrets for config/deploy.yml. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# A short-lived token for Artifact Registry, always from the personal house-bills gcloud configuration.
KAMAL_REGISTRY_PASSWORD=$(gcloud auth print-access-token --configuration=house-bills)

# Never check config/master.key into git! A copy is kept in the password manager.
RAILS_MASTER_KEY=$(cat config/master.key)
